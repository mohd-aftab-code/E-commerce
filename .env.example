# ============================================================================
# Print Studio 24 — Environment Variables Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------

# Full public URL of the application (no trailing slash)
# Example: https://printstudio24.com or http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment: development | production | test
NODE_ENV=development

# ----------------------------------------------------------------------------
# Database — MySQL (REQUIRED)
#
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Example: mysql://root:password@localhost:3306/print_studio_24
# ----------------------------------------------------------------------------

DATABASE_URL=mysql://root:password@localhost:3306/print_studio_24
password 1234

# ----------------------------------------------------------------------------
# Authentication — NextAuth.js
#
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# NEXTAUTH_URL must match NEXT_PUBLIC_APP_URL in production.
# ----------------------------------------------------------------------------

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-generate-with-openssl-rand-base64-32

# ----------------------------------------------------------------------------
# Stripe — Payments (REQUIRED for payment features)
#
# Get keys from: https://dashboard.stripe.com/apikeys
# Use TEST keys in development, LIVE keys in production only.
# NEVER expose STRIPE_SECRET_KEY to the browser.
# ----------------------------------------------------------------------------

STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ----------------------------------------------------------------------------
# Object Storage — Artwork & Asset Uploads
#
# Abstracted to support S3-compatible storage (AWS S3, DigitalOcean Spaces,
# Cloudflare R2, MinIO, etc.). Uncomment and fill in when implementing uploads.
# ----------------------------------------------------------------------------

# Storage provider: s3 | r2 | spaces | local (development only)
# STORAGE_PROVIDER=s3

# AWS S3 / S3-compatible storage
# STORAGE_BUCKET=print-studio-24-artwork
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=https://s3.amazonaws.com  # Override for non-AWS providers
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_URL=https://cdn.printstudio24.com  # Optional CDN URL

# ----------------------------------------------------------------------------
# Redis — Caching & Background Jobs (future)
#
# Uncomment when implementing Redis-backed caching or job queues.
# ----------------------------------------------------------------------------

# REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Email (future — transactional email)
#
# For order confirmations, password resets, etc.
# ----------------------------------------------------------------------------

# EMAIL_FROM=noreply@printstudio24.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ----------------------------------------------------------------------------
# Business Information
#
# Non-sensitive business details displayed on the site.
# Using env vars allows updates without code deploys.
# ----------------------------------------------------------------------------

NEXT_PUBLIC_BUSINESS_NAME=Print Studio 24
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_ZIP=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=

# ----------------------------------------------------------------------------
# SEO / Analytics (future)
# ----------------------------------------------------------------------------

# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
