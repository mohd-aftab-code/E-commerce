# .gitattributes — Normalize line endings to LF in the repository
# Prevents the LF/CRLF mixed-line-ending issues on Windows/Mac collaboration.

# Default: normalize all text files to LF on commit
* text=auto eol=lf

# Explicitly mark binary files to prevent corruption
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.gz binary
*.tgz binary

# Lock files — don't normalize
package-lock.json text eol=lf
yarn.lock text eol=lf
