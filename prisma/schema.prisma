// ============================================================================
// Prisma Schema — Print Studio 24
//
// Database: MySQL (required per project spec)
// ORM: Prisma 5.x (compatible with Node.js 20.11.1)
//
// ARCHITECTURE NOTES:
// -------------------
// This schema is the initial "Phase 1" version. It contains the core entities
// needed to support the platform's authentication and user management modules.
//
// Entities are designed with future scale in mind:
//  - All tables use CUID strings as primary keys (avoids sequential ID exposure)
//  - Soft-delete strategy: deletedAt field on applicable entities
//  - Timestamps: createdAt / updatedAt on every table
//  - Indexes: indexed on foreign keys and frequently-queried fields
//  - Enums: defined in Prisma (mapped to VARCHAR in MySQL)
//
// Entities planned for future phases (not yet created to avoid premature
// migrations):
//  Category, Product, ProductImage, ProductVariant, ProductOption,
//  OptionValue, PricingRule, PricingTier, Cart, CartItem, Order,
//  OrderItem, OrderItemOption, Artwork, ArtworkVersion, Payment, Refund,
//  Shipment, ShippingMethod, Quote, QuoteItem, Coupon, Discount,
//  Review, Notification, AuditLog
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

// ---------------------------------------------------------------------------
// User
//
// Central identity entity. A user may be a storefront customer, admin, or
// staff member (controlled by `role`).
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique @db.VarChar(254)
  emailVerified DateTime?
  // Nullable: OAuth-only accounts will not have a password
  passwordHash  String?    @db.VarChar(255)
  firstName     String     @db.VarChar(50)
  lastName      String     @db.VarChar(50)
  phone         String?    @db.VarChar(20)
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(PENDING_VERIFICATION)
  avatarUrl     String?    @db.VarChar(500)

  // Soft delete — do not hard-delete user records
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  addresses Address[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Session
//
// Server-managed sessions. Compatible with NextAuth database adapter.
// ---------------------------------------------------------------------------

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @db.VarChar(500)
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([expires])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// VerificationToken
//
// Used for email verification and password reset flows.
// Compatible with NextAuth database adapter.
// ---------------------------------------------------------------------------

model VerificationToken {
  identifier String   @db.VarChar(254)
  token      String   @unique @db.VarChar(500)
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Address
//
// Reusable address book for customers. US address format.
// ---------------------------------------------------------------------------

model Address {
  id           String  @id @default(cuid())
  userId       String
  label        String? @db.VarChar(50)
  firstName    String  @db.VarChar(50)
  lastName     String  @db.VarChar(50)
  company      String? @db.VarChar(100)
  addressLine1 String  @db.VarChar(100)
  addressLine2 String? @db.VarChar(100)
  city         String  @db.VarChar(100)
  state        String  @db.VarChar(2)
  zipCode      String  @db.VarChar(10)
  country      String  @default("US") @db.VarChar(2)
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@map("addresses")
}

// ============================================================================
// PHASE 3: E-COMMERCE MODELS
// ============================================================================

// ---------------------------------------------------------------------------
// Category
// ---------------------------------------------------------------------------
model Category {
  id          String    @id @default(cuid())
  slug        String    @unique @db.VarChar(100)
  name        String    @db.VarChar(100)
  description String?   @db.Text
  imageUrl    String?   @db.VarChar(500)
  isFeatured  Boolean   @default(false)
  sortOrder   Int       @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@index([slug])
  @@index([isFeatured])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// Product
// ---------------------------------------------------------------------------
model Product {
  id           String    @id @default(cuid())
  categoryId   String
  slug         String    @unique @db.VarChar(100)
  name         String    @db.VarChar(100)
  shortDesc    String?   @db.VarChar(255)
  description  String?   @db.Text
  imageUrl     String?   @db.VarChar(500)
  basePrice    Int       // Stored in cents (e.g., $10.00 = 1000)
  isPopular    Boolean   @default(false)
  isActive     Boolean   @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  category     Category        @relation(fields: [categoryId], references: [id])
  options      ProductOption[]
  pricingTiers PricingTier[]

  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
  @@map("products")
}

// ---------------------------------------------------------------------------
// ProductOption
//
// Represents a customization choice for a product (e.g., "Size", "Paper Type")
// ---------------------------------------------------------------------------
model ProductOption {
  id          String    @id @default(cuid())
  productId   String
  name        String    @db.VarChar(100)
  type        String    @default("SELECT") @db.VarChar(50) // SELECT, RADIO
  isRequired  Boolean   @default(true)
  sortOrder   Int       @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  OptionValue[]

  @@index([productId])
  @@map("product_options")
}

// ---------------------------------------------------------------------------
// OptionValue
//
// Represents the actual choice within an Option (e.g., "2x3.5", "16pt Glossy")
// ---------------------------------------------------------------------------
model OptionValue {
  id             String        @id @default(cuid())
  optionId       String
  label          String        @db.VarChar(100)
  priceModifier  Int           @default(0) // Extra cost in cents (e.g. $5 = 500)
  isDefault      Boolean       @default(false)
  sortOrder      Int           @default(0)

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId])
  @@map("option_values")
}

// ---------------------------------------------------------------------------
// PricingTier
//
// Represents quantity-based pricing for a product
// ---------------------------------------------------------------------------
model PricingTier {
  id         String  @id @default(cuid())
  productId  String
  quantity   Int
  price      Int     // Total price for this quantity in cents
  
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, quantity])
  @@index([productId])
  @@map("pricing_tiers")
}
